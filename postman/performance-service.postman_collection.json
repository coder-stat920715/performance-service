    {
      "name": "01 - Write path (command side)",
      "item": [
        {
          "name": "Create transaction",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ref = 'ref-' + Date.now() + '-' + Math.floor(Math.random() * 1e6);",
                  "pm.collectionVariables.set('reference', ref);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test('status is PENDING', () => pm.expect(j.status).to.eql('PENDING'));",
                  "pm.test('id is a UUID', () => pm.expect(j.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/));",
                  "pm.test('Location header points at the new resource', () => pm.expect(pm.response.headers.get('Location')).to.include(j.id));",
                  "pm.test('amount and currency echoed', () => { pm.expect(j.amount).to.eql(125.5); pm.expect(j.currency).to.eql('USD'); });",
                  "pm.collectionVariables.set('transactionId', j.id);",
                  "pm.collectionVariables.set('cursor', j.createdAt);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "transactions"
              ]
            },
            "description": "Command path: Bulkhead -> CircuitBreaker -> Retry -> @Transactional insert -> Kafka event after commit. Saves transactionId for later requests.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reference\": \"{{reference}}\",\n  \"accountId\": \"{{accountId}}\",\n  \"amount\": 125.5000,\n  \"currency\": \"USD\",\n  \"type\": \"CREDIT\",\n  \"description\": \"Postman test transaction\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Create transaction - idempotent replay",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('same id as first call', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('transactionId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "transactions"
              ]
            },
            "description": "Re-sends the SAME reference. Must return the existing row (same id), not create a duplicate.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reference\": \"{{reference}}\",\n  \"accountId\": \"{{accountId}}\",\n  \"amount\": 125.5000,\n  \"currency\": \"USD\",\n  \"type\": \"CREDIT\",\n  \"description\": \"Postman test transaction\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "02 - Read path (async + caching)",
      "item": [
        {
          "name": "Get by id (immediately)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('status is a valid state', () => pm.expect(['PENDING','COMPLETED']).to.include(pm.response.json().status));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions/{{transactionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "transactions",
                "{{transactionId}}"
              ]
            },
            "description": "Right after creation. Status may be PENDING or already COMPLETED. PENDING rows are never cached."
          }
        },
        {
          "name": "Get by id - poll until COMPLETED",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "setTimeout(function () {}, 500);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "const tries = parseInt(pm.collectionVariables.get('pollTries') || '0');",
                  "if (j.status !== 'COMPLETED' && tries < 10) {",
                  "  pm.collectionVariables.set('pollTries', String(tries + 1));",
                  "  postman.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "  pm.collectionVariables.unset('pollTries');",
                  "  pm.test('status COMPLETED (Kafka consumer finished)', () => pm.expect(j.status).to.eql('COMPLETED'));",
                  "  pm.test('updatedAt >= createdAt', () => pm.expect(new Date(j.updatedAt) >= new Date(j.createdAt)).to.be.true);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions/{{transactionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "transactions",
                "{{transactionId}}"
              ]
            },
            "description": "Proves the Kafka consumer processed the event. Under the Collection Runner this request re-runs itself (max 10 tries, 500 ms apart). When sending manually, just click Send again until status is COMPLETED."
          }
        },
        {
          "name": "Get by id - served from cache",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('status COMPLETED', () => pm.expect(pm.response.json().status).to.eql('COMPLETED'));",
                  "console.log('Cached read took ' + pm.response.responseTime + ' ms');",
                  "pm.test('responds quickly (< 250 ms)', () => pm.expect(pm.response.responseTime).to.be.below(250));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions/{{transactionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "transactions",
                "{{transactionId}}"
              ]
            },
            "description": "COMPLETED rows are now cached (L1 Caffeine, 30 s). Expect a very low response time. Confirm via /actuator/metrics/cache.gets?tag=result:hit."
          }
        },
        {
          "name": "Get by id - after L1 expiry (L2 Redis hit)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Wait for the Caffeine L1 TTL (30 s) to elapse",
                  "setTimeout(function () {}, 31000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('still COMPLETED', () => pm.expect(pm.response.json().status).to.eql('COMPLETED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions/{{transactionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "transactions",
                "{{transactionId}}"
              ]
            },
            "description": "Pre-request waits 31 s so the 30 s L1 entry expires. The read then misses L1 and hits L2 Redis (TTL 300 s): perf_cache_requests_total{tier=\"l2\",result=\"hit\"} increases."
          }
        },
        {
          "name": "Get by id - unknown id -> 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));",
                  "pm.test('Content is a ProblemDetail', () => {",
                  "  const j = pm.response.json();",
                  "  pm.expect(j.status).to.eql(404);",
                  "  pm.expect(j.title).to.eql('Not Found');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions/00000000-0000-0000-0000-000000000000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "transactions",
                "00000000-0000-0000-0000-000000000000"
              ]
            },
            "description": "Not-found is ignored by the circuit breaker and retry (it is not a system failure)."
          }
        },
        {
          "name": "Get by id - malformed id -> 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Content is a ProblemDetail', () => {",
                  "  const j = pm.response.json();",
                  "  pm.expect(j.status).to.eql(400);",
                  "  pm.expect(j.title).to.eql('Bad Request');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions/not-a-uuid",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "transactions",
                "not-a-uuid"
              ]
            },
            "description": "Type-mismatch handling."
          }
        }
      ]
    },
