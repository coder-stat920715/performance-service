{
  "info": {
    "name": "performance-service",
    "description": "Postman collection for the Spring Boot performance-service. Run folders in order 00 -> 05 with the Collection Runner. Folder 06 is manual (failure injection). See TESTING.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{username}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{password}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "accountId",
      "value": "acc-postman-1"
    },
    {
      "key": "reference",
      "value": ""
    },
    {
      "key": "transactionId",
      "value": ""
    },
    {
      "key": "cursor",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 - Health & Security",
      "item": [
