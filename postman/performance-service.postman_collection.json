              ],
              "path": [
                "actuator",
                "health",
                "readiness"
              ]
            },
            "description": "Kubernetes-style readiness probe.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "API without credentials -> 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));"
