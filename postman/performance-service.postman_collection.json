          "name": "Health (no auth)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('status UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            },
            "description": "Public endpoint. Confirms the app, Postgres, Redis and circuit-breaker health indicators are UP.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Readiness probe (no auth)",
          "event": [
            {
              "listen": "test",
              "script": {
