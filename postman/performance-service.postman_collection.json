        {
          "name": "List by account - page 1 (limit 2)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const a = pm.response.json();",
                  "pm.test('returns at most 2 items', () => pm.expect(a.length).to.be.within(1, 2));",
                  "pm.test('sorted by createdAt desc', () => { for (let i = 1; i < a.length; i++) pm.expect(new Date(a[i-1].createdAt) >= new Date(a[i].createdAt)).to.be.true; });",
                  "pm.test('all rows belong to the account', () => a.forEach(t => pm.expect(t.accountId).to.eql(pm.collectionVariables.get('accountId'))));",
                  "pm.collectionVariables.set('cursor', a[a.length - 1].createdAt);"
                ]
              }
            }
